# homelib — copy to .env, then `docker compose -f docker/docker-compose.yml up -d --build`
# Every value below has a working default for a local, fully self-hosted run.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=homelib_local_dev
DATABASE_URL=postgresql://homelib:homelib_local_dev@localhost:5432/homelib

# ── LLM (OpenAI-compatible endpoint) ────────────────────────────────────────
# Default: the Ollama container inside this compose stack. Nothing to sign up for.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# Optional override — a cloud provider, or a host-side Ollama with GPU access:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
# or:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1

# ── Streamlit Community Cloud (submission-day showcase ONLY) ────────────────
# Compose / reviewer path keeps Ollama above. Do NOT uncomment these for
# local `just up` — cloud is an env override on the demo app, not the default.
#
# Primary free OpenAI-compatible provider: Groq (no card, tool calling +
# JSON mode, ~30 RPM / ~1k RPD on free tier — enough for peer reviewers).
# Console: https://console.groq.com/keys
# Compatible base path already matches OpenAIClient (`…/openai/v1`).
#
# Shortest form — ONE secret: GROQ_API_KEY=gsk_… (LLM_API_KEY blank or absent).
# OpenAIClient then targets Groq with GROQ_MODEL (default llama-3.3-70b-versatile).
# The explicit triple below still works and wins whenever LLM_API_KEY is set:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_…          # paste real key only in Streamlit Secrets / local .env (never commit)
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_TIMEOUT_SECONDS=90     # cloud-demo suggestion; Compose stays 300
#   APP_MODE=demo
#
# Streamlit Secrets (same names as env — flat TOML keys):
#   LLM_BASE_URL = "https://api.groq.com/openai/v1"
#   LLM_API_KEY = "gsk_…"
#   LLM_MODEL = "llama-3.3-70b-versatile"
#   LLM_TIMEOUT_SECONDS = "90"
#   APP_MODE = "demo"
#   HOMELIB_SQLITE_PATH = "data/homelib.sqlite"
#
# Fail-closed: if the key is missing/invalid, ask/mentor return degraded
# answers (search still works). Budget = Groq free-tier rate limits only —
# no paid Stripe/LLM lane. Local fallback: leave the Ollama block active.

# Optional — how long the API waits on a chat-completion call before giving
# up. Default 300s is sized for CPU-only Ollama in this compose stack
# (measured ~7.4 tok/s generation, ~49 tok/s prefill: a real /v1/ask costs
# ~70s minimum). Lower this if LLM_BASE_URL points at a GPU-backed host.
# Cloud-demo (Streamlit Community Cloud) default is 90 — do not use 90 as the
# Compose reviewer default.
# LLM_TIMEOUT_SECONDS=300

# ── Edition (v2 skeleton — does not switch the store off Postgres yet) ──────
# demo = local rehearsal of the public showcase (resettable seed, later).
# selfhosted = home / reviewer Compose. Unset also means selfhosted.
APP_MODE=demo
# LLM_MAX_OUTPUT_TOKENS=800
# HOMELIB_BIND=127.0.0.1   # reserved; LAN for Streamlit uses HOMELIB_UI_BIND
# MiniPS / home Wi-Fi (same pattern as Forgejo on :3000): publish UI on LAN.
# Reviewer default is loopback — only set 0.0.0.0 on a trusted home network.
# HOMELIB_UI_BIND=0.0.0.0
# READ_PORT=8502            # clean /read HTML for Safari Listen to Page. Also
# the host-side published port for the :8502 companion AND the port the UI
# reads to build its own link text (apps/ui/view_model.py:read_port()).
# HOMELIB_OFFICIAL_VIEWER=1 # off by default. Enables the :8502 /pdf + /book
# two-page Pottermore viewer — LAN opt-in only. Never set on the public
# capstone repo / Streamlit Cloud demo (Official preview stays links-only there).
# Host / non-compose: relative path from the repo root after seeding SQLite.
# HOMELIB_SQLITE_PATH=data/homelib.sqlite
# Compose api defaults to /data/homelib.sqlite (../data mounted). Override only
# if you relocate the file inside the container. A fresh clone has NO such
# file: the API creates an empty schema on first connect and /health says
# `degraded` with 0 books until `just seed-sqlite` has run.

# ── Cost estimate (query_log.cost_usd, Observatory "Cost estimate") ─────────
# Both default to 0 — a local Ollama run has no per-token price, so cost_usd
# stays 0 and Observatory's chart 6 falls back to summing tokens (unpriced).
# Set both to get a real USD estimate; list prices below are Groq's published
# per-1K-token rate for llama-3.3-70b-versatile (the public-demo model) as of
# this writing — check https://groq.com/pricing before relying on them.
# LLM_PRICE_PER_1K_PROMPT=0.00059
# LLM_PRICE_PER_1K_COMPLETION=0.00079
LLM_PRICE_PER_1K_PROMPT=0
LLM_PRICE_PER_1K_COMPLETION=0

# ── Online judge (C6, specs/monitoring.md) ──────────────────────────────────
# Off by default. Set to 1 ONLY if you want `scripts/judge_recent.py` to score
# live /v1/ask traffic — doing so persists each question's PLAINTEXT (not
# just its hash) to the new `answer_log` table. Read specs/monitoring.md's
# "Online judge" section before turning this on.
# HOMELIB_LOG_ANSWERS=1

# ── Tracing (C5, specs/monitoring.md) ───────────────────────────────────────
# Off by default. Spans (retrieve/rerank/rewrite/llm/cite) are always
# created and, with HOMELIB_SQLITE_PATH set, exported to the `spans` table —
# but every span attribute uses query_sha256_prefix, never the raw question,
# unless this is set to 1.
# HOMELIB_TRACE_QUESTIONS=1

# ── Embeddings (runs in-process, no service call) ───────────────────────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=homelib_local_dev

# ── Host ports ──────────────────────────────────────────────────────────────
# Only change these if something already listens on the default. Container-side
# ports never change, so nothing inside the stack is affected.
# API_PORT=8000
# UI_PORT=8501
# GRAFANA_PORT=3001
# POSTGRES_PORT=5432
# OLLAMA_PORT=11434

# Context window Ollama loads the model with. Pinned rather than left to the
# image default because Ollama truncates an over-long prompt silently instead
# of erroring: the model answers a question it was only shown part of, and
# nothing in the response says so. 16384 covers the 20-passage ceiling in
# _MAX_CONTEXT_HITS with room to generate.
OLLAMA_CONTEXT_LENGTH=16384
