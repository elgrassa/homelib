#!/usr/bin/env bash
# Fast local gate. Deliberately NOT the full suite.
#
# The division of labour is: this hook catches the things that are cheap to
# check and embarrassing to push (a syntax error, a type error, a committed
# secret, a broken unit test). Everything expensive — the integration tests
# against a live Postgres, the embedding-model loads, the coverage floor —
# runs on the PR, where it can take five minutes without anyone waiting on it.
#
# Budget: this must stay under ~1 minute. Measured at the time it was written:
# 355 tests in 7.5s, plus lint, mypy and a full-history secret scan. If it ever
# creeps toward the point where it is faster to push and wait, people will
# start passing --no-verify, and then it protects nothing.
#
# The 13 tests it skips are marked integration/slow/llm. They are not optional,
# they just belong on the other side of the push.
set -uo pipefail

fail=0
step() {
    local name="$1"; shift
    if "$@" >/tmp/homelib-prepush.log 2>&1; then
        printf '  ✓ %s\n' "$name"
    else
        printf '  ✗ %s\n' "$name"
        sed 's/^/      /' /tmp/homelib-prepush.log | tail -25
        fail=1
    fi
}

printf '\npre-push gate (fast — the full suite runs on the PR)\n'

# Scoped to TRACKED files, not the whole working tree. A push contains
# commits, not scratch: failing it because an unrelated untracked file is
# mid-edit — a concurrent agent's work in progress, a scratch script — blocks
# a push for something the push does not contain. That is how a gate teaches
# people --no-verify, and a bypassed gate protects nothing. Files that ARE
# part of the push are tracked, so they are still checked.
mapfile -t tracked_py < <(git ls-files '*.py')

step "ruff check"        uv run ruff check "${tracked_py[@]}"
step "ruff format"       uv run ruff format --check "${tracked_py[@]}"
step "mypy --strict"     uv run mypy

# Skipped rather than failed when gitleaks is absent, because a contributor
# without it should be told, not blocked. CI hard-errors on a missing binary,
# so the guarantee is not lost — only deferred.
#
# Scan only the commits this push actually sends. A full-history `gitleaks git`
# over this repo can hang for tens of minutes on large binary blobs in early
# history (corpus snapshots); CI still runs the full scan with a job budget.
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks_ok=1
    while read -r local_ref local_sha remote_ref remote_sha; do
        [[ -z "${local_sha:-}" || "$local_sha" =~ ^0+$ ]] && continue
        if [[ -z "${remote_sha:-}" || "$remote_sha" =~ ^0+$ ]]; then
            range_opts="--max-count=64"
        else
            range_opts="$remote_sha..$local_sha"
        fi
        if ! gitleaks git --config .gitleaks.toml --redact --no-banner \
                --log-opts="$range_opts" . >/tmp/homelib-prepush.log 2>&1; then
            printf '  ✗ gitleaks (%s)\n' "$local_ref"
            sed 's/^/      /' /tmp/homelib-prepush.log | tail -25
            gitleaks_ok=0
        fi
    done
    if [[ "$gitleaks_ok" -eq 1 ]]; then
        printf '  ✓ gitleaks (push range)\n'
    else
        fail=1
    fi
else
    printf '  ⚠ gitleaks not installed — history not scanned here (CI still enforces it)\n'
fi

step "tests (fast)"      uv run pytest -q --no-cov -m "not integration and not slow and not llm"

if [[ "$fail" -ne 0 ]]; then
    printf '\n✗ pre-push gate failed. Fix, or push with --no-verify if you know why.\n\n'
    exit 1
fi

printf '\n✓ pre-push gate passed. Full suite + coverage floor run on the PR.\n\n'
